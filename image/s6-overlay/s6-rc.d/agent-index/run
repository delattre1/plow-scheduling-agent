#!/bin/sh
# Report this agent's usage every 5 minutes. Registration is intentionally manual.
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
export AGENT_ID
HERMES_HOME=/var/lib/hermes
export HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID; standing down instead of guessing" >&2
  exec sleep 86400
fi

while :; do
  /command/s6-setuidgid hermes \
    env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" \
    /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
    status >/dev/null
  status=$?

  if [ "$status" -eq 3 ]; then
    echo "agent-index: not registered; reporting is standing down" >&2
  elif [ "$status" -ne 0 ]; then
    echo "agent-index: status exited $status; reporting is standing down" >&2
  else
    /command/s6-setuidgid hermes \
      env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" \
      /opt/hermes/.venv/bin/python3 /opt/plow/agent-index-client.py \
      || echo "agent-index: reporter exited non-zero" >&2
  fi

  /bin/sleep 300
done
